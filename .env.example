# GitLab API (required)
GITLAB_API_KEY=glpat-***
GITLAB_BASE_URL=https://gitlab.com

# LLM API (required)
ANTHROPIC_API_KEY=sk-ant-***
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-4-6

# Path to custom security scan instructions text file to append to audit prompt
CUSTOM_SECURITY_SCAN_INSTRUCTIONS=

# Filtering Options (optional, have defaults)

# Enable/disable hard exclusion rules (regex-based false positive filtering)
ENABLE_HARD_EXCLUSIONS=false
# Excluded directories (comma-separated list)
EXCLUDE_DIRECTORIES=

# Enable/disable LLM filtering (two-stage filtering)
ENABLE_CLAUDE_FILTERING=false
# Path to custom false positive filtering instructions text file
CUSTOM_FILTER_INSTRUCTIONS=
